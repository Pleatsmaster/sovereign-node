# life0-pulse.service — one deterministic LIFE-0 pulse.
# Installed by scripts/install_pulse_timer.sh (SCHEDULER-AUDIT-0 repair).
# The pulse is read-only on the world; it writes only its own state dir.
#
# Environment notes (from the audit):
# - HOME=/home/hatch: sensors resolve ~/workspace paths via Path.home().
# - proxy.env: egress proxy variables snapshotted at install time by the
#   installer (600, root-owned). urllib needs them to reach api.github.com.
[Unit]
Description=LIFE-0 hourly deterministic pulse (SCHEDULER-AUDIT-0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/home/hatch
EnvironmentFile=/home/hatch/workspace/namariel-live0/life-0/systemd/proxy.env
ExecStart=/home/hatch/workspace/namariel-live0/life-0/scripts/run_pulse_locked.sh
StandardOutput=append:/home/hatch/workspace/namariel-live0/life-0/state/pulse_cron.log
StandardError=append:/home/hatch/workspace/namariel-live0/life-0/state/pulse_cron.log
PrivateTmp=true
